generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum userRole {
  admin
  psychologist
  user
}

enum userType {
  itmStudent
  itmEmployee
  external
}

enum questionType {
  single_choice
  multiple_choice
  likert
  open_text
  numeric
  time_input
}

enum assignmentStatus {
  assigned
  in_progress
  completed
  expired
}

enum assignmentAttentionLevel {
  high
  medium
  low
  none
}

model user {
  userId                 String    @id @default(uuid()) @db.Uuid
  userNumber             String    @unique
  email                  String    @unique
  password               String?
  name                   String
  gender                 String?
  birthDate              DateTime?
  userType               userType  @default(external)
  role                   userRole
  isActive               Boolean   @default(false)
  lastLogin              DateTime?
  passwordChangedAt      DateTime?
  mustChangePassword     Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  verifiedEmail          Boolean   @default(false)
  assignedPsychologistId String?   @db.Uuid
  assignedPsychologistAt DateTime?
  followUpAt             DateTime?

  // relations
  assignedPsychologist user?        @relation("psychologistAssignments", fields: [assignedPsychologistId], references: [userId])
  assignedStudents     user[]       @relation("psychologistAssignments")
  createdTests         test[]       @relation("testCreatedBy")
  assignmentsTo        assignment[] @relation("assignedTo")
  assignmentsBy        assignment[] @relation("assignedBy")
  @@index([assignedPsychologistId])
  @@map("user")
}

model test {
  testId      String   @id @default(uuid()) @db.Uuid
  testCode    String?  @unique
  title       String
  description String?
  isPublished Boolean  @default(false)
  createdById String?  @db.Uuid
  createdBy   user?    @relation("testCreatedBy", fields: [createdById], references: [userId])
  createdAt   DateTime @default(now())

  sections    testSection[]
  questions   question[]
  assignments assignment[]

  @@map("tests")
}

model testSection {
  testSectionId   String     @id @default(uuid()) @db.Uuid
  testSectionCode String?
  testId          String     @db.Uuid
  name            String?
  test            test       @relation(fields: [testId], references: [testId], onDelete: Cascade)
  questions       question[]

  @@map("testSections")
}

model question {
  questionId    String  @id @default(uuid()) @db.Uuid
  testId        String  @db.Uuid
  testSectionId String? @db.Uuid
  type          questionType @default(single_choice)
  code          String?
  prompt        String
  required      Boolean @default(true)
  metadata      Json?
  condition     Json?

  section        testSection?     @relation(fields: [testSectionId], references: [testSectionId])
  test           test             @relation(fields: [testId], references: [testId], onDelete: Cascade)
  questionOption questionOption[]
  answers        answer[]

  @@unique([testId, code])
  @@map("questions")
}

model questionOption {
  questionOptionId String @id @default(uuid()) @db.Uuid
  questionId       String @db.Uuid

  label      String
  value      String?
  scoreValue Decimal? @db.Decimal(10, 2)

  question question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  answers  answer[]

  @@map("questionsOptions")
}

model assignment {
  assignmentId String @id @default(uuid()) @db.Uuid
  testId       String @db.Uuid

  assignedToId String @db.Uuid
  assignedById String @db.Uuid
  status       assignmentStatus @default(assigned)

  dueAt       DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  assignedBy user             @relation("assignedBy", fields: [assignedById], references: [userId])
  assignedTo user             @relation("assignedTo", fields: [assignedToId], references: [userId])
  test       test             @relation(fields: [testId], references: [testId], onDelete: Cascade, onUpdate: Cascade)
  answers    answer[]
  score      assignmentScore?

  @@index([assignedToId, status])
  @@unique([assignedToId, testId])
  @@map("assignments")
}

model answer {
  answerId         String   @id @default(uuid()) @db.Uuid
  assignmentId     String   @db.Uuid
  questionId       String   @db.Uuid
  questionOptionId String?  @db.Uuid
  textValue        String?

  question   question        @relation(fields: [questionId], references: [questionId])
  option     questionOption? @relation(fields: [questionOptionId], references: [questionOptionId])
  assignment assignment      @relation(fields: [assignmentId], references: [assignmentId], onDelete: Cascade)

  @@unique([assignmentId, questionId])
  @@map("answers")
}

model assignmentScore {
  assignmentId String     @id @db.Uuid
  assignment   assignment @relation(fields: [assignmentId], references: [assignmentId], onDelete: Cascade)

  totalScore     Decimal  @db.Decimal(12, 4)
  percentile     Decimal? @db.Decimal(6, 3)
  attentionLevel assignmentAttentionLevel @default(none)
  interpretation String?
  details        Json?

  @@index([attentionLevel])
  @@map("assignmentScores")
}
