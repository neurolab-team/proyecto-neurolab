generator client {
  provider = "prisma-client"
  output   = "../packages/libs/prisma/generated"
}

datasource db {
  provider = "sqlserver"
}

model user {
  userId                 String    @id @default(uuid()) @db.UniqueIdentifier
  userNumber             String    @unique
  email                  String    @unique
  password               String?
  name                   String
  gender                 String?
  birthDate              DateTime?
  userType               String    @default("external")
  role                   String
  isActive               Boolean   @default(false)
  lastLogin              DateTime?
  passwordChangedAt      DateTime?
  mustChangePassword     Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  verifiedEmail          Boolean   @default(false)
  dataPolicyAcceptedAt   DateTime?
  assignedPsychologistId String?   @db.UniqueIdentifier
  assignedPsychologistAt DateTime?
  followUpAt             DateTime?

  // Encuesta externa de usabilidad (Google Forms) disparada al completar las
  // 3 pruebas de sueño. "PromptedAt" = se disparó (se mandó el correo y se
  // debe mostrar el modal); "ClickedAt" = el usuario abrió el link, deja de
  // insistirse.
  usabilitySurveyPromptedAt DateTime?
  usabilitySurveyClickedAt  DateTime?

  // relations
  assignedPsychologist user?        @relation("psychologistAssignments", fields: [assignedPsychologistId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  assignedStudents     user[]       @relation("psychologistAssignments")
  createdTests         test[]       @relation("testCreatedBy")
  assignmentsTo        assignment[] @relation("assignedTo")
  assignmentsBy        assignment[] @relation("assignedBy")
  studyConsents        studyConsent[]
  @@index([assignedPsychologistId])
  @@map("user")
}

model test {
  testId      String   @id @default(uuid()) @db.UniqueIdentifier
  testCode    String?  @unique
  title       String
  description String?
  audience    String   @default("user")
  isPublished Boolean  @default(false)
  createdById String?  @db.UniqueIdentifier
  createdBy   user?    @relation("testCreatedBy", fields: [createdById], references: [userId], onDelete: SetNull, onUpdate: NoAction)
  createdAt   DateTime @default(now())

  sections    testSection[]
  questions   question[]
  assignments assignment[]

  @@map("tests")
}

model testSection {
  testSectionId   String     @id @default(uuid()) @db.UniqueIdentifier
  testSectionCode String?
  testId          String     @db.UniqueIdentifier
  name            String?
  test            test       @relation(fields: [testId], references: [testId], onDelete: Cascade, onUpdate: NoAction)
  questions       question[]

  @@map("testSections")
}

model question {
  questionId    String   @id @default(uuid()) @db.UniqueIdentifier
  testId        String   @db.UniqueIdentifier
  testSectionId String?  @db.UniqueIdentifier
  type          String   @default("single_choice")
  code          String?
  prompt        String
  required      Boolean  @default(true)
  metadata      String?
  condition     String?

  section        testSection?     @relation(fields: [testSectionId], references: [testSectionId], onDelete: NoAction, onUpdate: NoAction)
  test           test             @relation(fields: [testId], references: [testId], onDelete: Cascade, onUpdate: NoAction)
  questionOption questionOption[]
  answers        answer[]

  @@unique([testId, code])
  @@map("questions")
}

model questionOption {
  questionOptionId String @id @default(uuid()) @db.UniqueIdentifier
  questionId       String @db.UniqueIdentifier

  label      String
  value      String?
  scoreValue Decimal? @db.Decimal(10, 2)

  question question @relation(fields: [questionId], references: [questionId], onDelete: Cascade, onUpdate: NoAction)
  answers  answer[]

  @@map("questionsOptions")
}

model assignment {
  assignmentId String @id @default(uuid()) @db.UniqueIdentifier
  testId       String @db.UniqueIdentifier

  assignedToId String @db.UniqueIdentifier
  assignedById String @db.UniqueIdentifier
  status       String @default("assigned")

  dueAt       DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  // DEPRECADO: el consentimiento ahora vive en `studyConsent` (uno por
  // estudio, no por prueba). Se conservan solo como respaldo de la migración
  // 20260928000000_add_study_consents; se eliminarán en una migración posterior.
  consentStatus      String? // "accepted" | "declined" | null = pendiente
  consentRespondedAt DateTime?
  consentVersion     String?

  assignedBy user             @relation("assignedBy", fields: [assignedById], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  assignedTo user             @relation("assignedTo", fields: [assignedToId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  test       test             @relation(fields: [testId], references: [testId], onDelete: Cascade, onUpdate: NoAction)
  answers    answer[]
  score      assignmentScore?

  @@index([assignedToId, status])
  @@unique([assignedToId, testId])
  @@map("assignments")
}

model answer {
  answerId         String  @id @default(uuid()) @db.UniqueIdentifier
  assignmentId     String  @db.UniqueIdentifier
  questionId       String  @db.UniqueIdentifier
  questionOptionId String? @db.UniqueIdentifier
  textValue        String?

  question   question        @relation(fields: [questionId], references: [questionId], onDelete: NoAction, onUpdate: NoAction)
  option     questionOption? @relation(fields: [questionOptionId], references: [questionOptionId], onDelete: NoAction, onUpdate: NoAction)
  assignment assignment      @relation(fields: [assignmentId], references: [assignmentId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assignmentId, questionId])
  @@map("answers")
}

model assignmentScore {
  assignmentId String     @id @db.UniqueIdentifier
  assignment   assignment @relation(fields: [assignmentId], references: [assignmentId], onDelete: Cascade, onUpdate: NoAction)

  totalScore     Decimal  @db.Decimal(12, 4)
  percentile     Decimal? @db.Decimal(6, 3)
  attentionLevel String   @default("none")
  interpretation String?
  clinicalInterpretation String?
  details        String?

  @@index([attentionLevel])
  @@map("assignmentScores")
}

// Consentimiento informado por estudio (p. ej. las 3 pruebas de sueño de
// MATELAB II). Es de solo inserción: cada decisión del usuario es una fila
// nueva y la vigente es la más reciente por (userId, studyCode). Así queda la
// trazabilidad de qué aceptó, cuándo, sobre qué versión del texto y desde qué
// prueba. Si la decisión es idéntica a la vigente no se inserta otra fila.
//
// `assignmentId` y `testCode` son una foto del contexto, sin FK a propósito:
// el registro de consentimiento debe sobrevivir aunque la asignación o la
// prueba se eliminen.
model studyConsent {
  studyConsentId     String   @id @default(uuid()) @db.UniqueIdentifier
  userId             String   @db.UniqueIdentifier
  studyCode          String   @db.NVarChar(50)
  version            String   @db.NVarChar(50)
  status             String   @db.NVarChar(20) // "accepted" | "declined"
  allowsSleepTips    Boolean  @default(false)
  allowsStudyInvites Boolean  @default(false)
  source             String   @default("user") @db.NVarChar(50) // "user" | "migrated_from_assignment"
  assignmentId       String?  @db.UniqueIdentifier // asignación desde la que se decidió
  testCode           String?  @db.NVarChar(50) // prueba desde la que se decidió
  respondedAt        DateTime @default(now())

  user user @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, studyCode, respondedAt])
  @@map("studyConsents")
}
